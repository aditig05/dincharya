# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=your_sarvam_api_key_here
# Postgres connection string (e.g. from Neon). Leave empty to keep data only in the browser.
DATABASE_URL=
# Sign in with Google: OAuth client ID (Google Cloud Console > Credentials > OAuth client ID, type Web)
GOOGLE_CLIENT_ID=
# Random string, 32+ characters, used to sign session cookies
SESSION_SECRET=
# Local testing only: 1 shows a test sign-in button (ignored on Vercel)
DEV_LOGIN=
PORT=3000
# Free fallbacks, used automatically when Sarvam fails (e.g. credits used up). Optional.
GROQ_API_KEY=
GEMINI_API_KEY=
# auto (Sarvam first, then free) | free (skip Sarvam) | sarvam (no fallback)
AI_PROVIDER=auto
# Optional: Upstash Redis REST (shared rate limiting across server instances)
KV_REST_API_URL=
KV_REST_API_TOKEN=
