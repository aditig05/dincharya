# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=your_sarvam_api_key_here
# Postgres connection string (e.g. from Neon). Leave empty to keep data only in the browser.
DATABASE_URL=
# Passcode you type once on each device to sync your log
SYNC_PASSCODE=choose-a-passcode
PORT=3000
# Free fallbacks, used automatically when Sarvam fails (e.g. credits used up). Optional.
GROQ_API_KEY=
GEMINI_API_KEY=
# auto (Sarvam first, then free) | free (skip Sarvam) | sarvam (no fallback)
AI_PROVIDER=auto
